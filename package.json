{
  "name": "obsidian-gym-manager",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "desktop:build": "npm run build && node scripts/prepare-desktop-runtime.cjs && electron-builder --win nsis && node scripts/verify-desktop-package.cjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@zxing/browser": "^0.1.5",
    "docx": "^9.7.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "jspdf": "^4.2.1",
    "next": "16.2.6",
    "pg": "8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.obsidian.gymmanager",
    "productName": "Obsidian Gym Manager",
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-runtime",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/next-server-wrapper.cjs",
        "to": "next-server-wrapper.cjs"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "desktopName": "obsidian-gym-manager",
      "syncDesktopName": true
    }
  },
  "description": "Offline-first encrypted gym management application",
  "author": {
    "name": "Obsidian Gym Manager",
    "email": "support@obsidian-gym-manager.local"
  }
}
